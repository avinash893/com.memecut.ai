    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "multer": "^2.0.0",
    "node-fetch": "^3.3.2",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
